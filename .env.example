# =====================================================
# Mentio — Environment Variables
# Copy to .env (never commit it). In production set these in your host's
# secret manager. The app refuses to start in production if they are unsafe.
# =====================================================

# --- Required ---------------------------------------------------------------
# PostgreSQL. Needs the btree_gist extension (Neon, Supabase, RDS, Vercel Postgres all allow it).
DATABASE_URL="postgresql://user:password@localhost:5432/mentio?schema=public"

# Session signing secret, min 32 chars. Generate: openssl rand -base64 32
# There is NO default: the app will not start without one.
AUTH_SECRET=""

# Public origin of the site. Must be https:// in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# --- Required in production ---------------------------------------------------
# Transactional email (password reset, email verification, booking notices).
# In development, emails are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Mentio <noreply@your-verified-domain.com>"

# --- Optional -----------------------------------------------------------------
# Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Payments: only "free_beta" exists. All sessions are free; mentors cannot set a price.
PAYMENTS_MODE="free_beta"

# Calendar OAuth (Cal.com / Calendly) is OFF by default. See docs/FEATURES.md before enabling.
CALENDAR_OAUTH_ENABLED="false"
CAL_COM_CLIENT_ID=""
CAL_COM_CLIENT_SECRET=""
CALENDLY_CLIENT_ID=""
CALENDLY_CLIENT_SECRET=""
# HMAC secret configured on each Cal.com webhook; Calendly's OAuth app signing key.
CAL_COM_WEBHOOK_SECRET=""
CALENDLY_WEBHOOK_SIGNING_KEY=""
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored calendar tokens.
TOKEN_ENCRYPTION_KEY=""
