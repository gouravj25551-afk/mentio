# =====================================================
# Mentio — Environment Variables (placeholders only)
# Copy to .env for local use. Never commit real values.
# =====================================================

# Supabase Postgres. Use the pooled URL for the app and the direct URL for migrations.
# Pooled (Supavisor transaction mode, port 6543):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432), used only by `npm run db:deploy`:
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app (https in production). Used for links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email via Resend. Required in production; in development mail is logged to the console if the key is empty.
EMAIL_FROM="Mentio <noreply@your-verified-domain.example>"
RESEND_API_KEY=""

# First admin, used only by `npm run admin:bootstrap` (run once, then remove these from any shared env).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# CAL_COM_CLIENT_ID=""
# CAL_COM_CLIENT_SECRET=""
# CALENDLY_CLIENT_ID=""
# CALENDLY_CLIENT_SECRET=""
