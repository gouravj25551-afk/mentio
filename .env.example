# =====================================================
# Mentio — Environment Variables
# =====================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mentio?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# UploadThing
UPLOADTHING_TOKEN=""

# Email (optional — logs to console in dev)
EMAIL_FROM="Mentio <noreply@mentio.app>"
RESEND_API_KEY=""

# Calendar integrations (optional — service layer uses mocks when unset)
CAL_COM_CLIENT_ID=""
CAL_COM_CLIENT_SECRET=""
CALENDLY_CLIENT_ID=""
CALENDLY_CLIENT_SECRET=""
